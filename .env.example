# Claude Code Server Configuration

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s

# Database Configuration
DATABASE_URL=postgres://claude:password@localhost:5432/claude_code_server?sslmode=disable
DATABASE_MAX_CONNECTIONS=25
DATABASE_MAX_IDLE_CONNECTIONS=5

# Claude Code Configuration
CLAUDE_CODE_BINARY=claude
CLAUDE_CODE_API_KEY=your-anthropic-api-key-here
MAX_CONCURRENT_SESSIONS=10
SESSION_TIMEOUT=1h

# Storage Configuration
WORKTREE_BASE_PATH=/var/lib/claude-code-server/worktrees
LOG_RETENTION_DAYS=30

# Security Configuration
JWT_SECRET=change-me-in-production
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=1m

# Observability Configuration
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ENABLED=true